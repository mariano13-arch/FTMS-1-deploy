POSTGRES_DB=ftms
POSTGRES_USER=ftms
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgis://ftms:local-development-only@db:5432/ftms
DJANGO_SECRET_KEY=local-development-key-change-me
DJANGO_DEBUG=true
DJANGO_TIME_ZONE=Asia/Manila
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
# SMTP credentials must be supplied through an untracked local or deployment environment.
# Never commit SMTP usernames, passwords, or app-specific credentials.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=
DRIVER_MOBILE_ACCOUNT_SETUP_URL=http://localhost:5173/setup-password
DRIVER_MOBILE_APP_DOWNLOAD_URL=
REDIS_URL=redis://redis:6379/0
TOMTOM_API_KEY=
DISPATCH_TELEMETRY_MAX_AGE_SECONDS=300
FTMS_TELEMETRY_CLOCK_SKEW_SECONDS=300
# Local capstone defense overlay only. Real telemetry remains the default and always wins.
FTMS_DEMO_TELEMETRY_ENABLED=false
FTMS_DEMO_TELEMETRY_CENTER_LATITUDE=
FTMS_DEMO_TELEMETRY_CENTER_LONGITUDE=
FTMS_DEMO_TELEMETRY_RADIUS_METERS=1500
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=ftms/v1/telemetry
MQTT_QOS=1
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_TOMTOM_MAPS_KEY=
